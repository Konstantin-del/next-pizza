
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("POSTGRES_URL")
    directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
    id Int @id @default(autoincrement())
    fullName String
    email String @unique
    password String
    user UserRole @default(USER)
    provider String?
    providerId String?

    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
    cart Cart?
    order Order?
    verificationCode VerificationCode?
}

model Category {
    id Int @id @default(autoincrement())
    name String @unique
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
    products Product[]
}

model Product {
    id Int @id @default(autoincrement())
    name String
    imageUrl String
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
    category Category @relation(fields: [categoryId], references: [id])
    categoryId Int
    ingredients Ingredient[]
    productOptions ProductOptions[]
}

model ProductOptions {
    id Int @id @default(autoincrement()) 
    price Int 
    size Int?
    pizzaType Int?
    product Product @relation(fields: [productId], references: [id])
    productId Int 
    cartOptions CartOption[]
}

model Ingredient {
    id Int @id @default(autoincrement())
    name String
    price Int
    imageUrl String
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
    products Product[]
    cartOptions CartOption[]
}

model Cart {
    id Int @id @default(autoincrement())
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
    totalAmount Int @default(0)
    token String?
    user  User? @relation(fields: [userId], references: [id])
    userId Int? @unique
    cartOptions CartOption[]
}

model CartOption {
    id Int @id @default(autoincrement())

    quentity Int
    ingredients Ingredient[]

    productOptions ProductOptions @relation(fields: [productOptionsId], references: [id])
    productOptionsId Int
    cart Cart @relation(fields: [cartId], references: [id])
    cartId Int
}

model Order {
    id Int @id @default(autoincrement())
    token String
    totalAmount Int
    user  User? @relation(fields: [userId], references: [id])
    userId Int? @unique
    status OrderStatus
    paymantId String?
    products Json
    fullName String
    address String
    email String
    phone String
    coments String?
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
}

model VerificationCode {
    id Int @id @default(autoincrement())
    code String @unique
    createdAt DateTime @default(now())
    

    user  User? @relation(fields: [userId], references: [id])
    userId Int? @unique
    @@unique([userId, code])
}

enum OrderStatus {
    PENDING
    SUCCEEDED
    CANSELLED
}

enum UserRole {
    USER
    ADMIN
}