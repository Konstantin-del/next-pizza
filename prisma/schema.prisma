
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("POSTGRES_URL")
    directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
    id Int @id @default(autoincrement())
    fullName String
    email String @unique
    password String
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
}

model Category {
    id Int @id @default(autoincrement())
    name String @unique
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
    products Product[]
}

model Product {
    id Int @id @default(autoincrement())
    name String
    imageUrl String
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
    category Category @relation(fields: [categoryId], references: [id])
    categoryId Int
}

model Ingredient {
    id Int @id @default(autoincrement())
    name String
    price Int
    imageUrl String
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
}